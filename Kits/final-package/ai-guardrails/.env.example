# Copy this file to .env and fill in the values you have.
#
# Nothing in this module HARD-REQUIRES real credentials: Notebook 1 falls
# back to a deterministic, offline chat model if GROQ_API_KEY is missing or
# a placeholder, and the LangSmith cells in Notebooks 1 & 4 skip gracefully
# without LANGSMITH_API_KEY. Fill these in only if you want the live paths.

# --- Groq (optional -- powers Notebook 1's live chat model) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# --- LangSmith (optional -- tracing + dataset seeding in Notebooks 1 & 4) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=branchline-nb1

# --- Guardrail tuning ---
# Number of detector hits required before the callback blocks a request.
INJECTION_BLOCK_THRESHOLD=1

# --- Audit log location (created automatically; change only if you have a reason to) ---
AUDIT_LOG_PATH=logs/audit_log.jsonl
