CONTENT_ROOT=C:\path\to\your\final-package

SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///./platform.db

REQUIRE_INSTRUCTOR_APPROVAL=true
INSTRUCTOR_SIGNUP_CODE=letmein-instructor

FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true to enable demo/showcase mode: auth is bypassed and a read-only
# guest session is used. Accepts: true/1/yes or false/0/no.
DEMO_MODE=false

# Razorpay payment credentials. Use test-mode keys from the Razorpay dashboard
# first. These are placeholders — never commit real secrets.
# The key id is exposed to the client only to open Standard Checkout; the key
# secret stays server-side and is never returned, logged, or shown in errors.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
